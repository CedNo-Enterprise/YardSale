# Store text files with LF in the repository regardless of the contributor's
# platform. Anything git detects as text and that has no rule below is checked
# out with the platform's native endings.
* text=auto

# Source, config and docs stay LF in the working tree too, so formatters,
# linters and diffs behave identically on Windows, macOS and Linux.
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.svg   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
.env*   text eol=lf

# Generated: keep it LF, but let review tooling collapse it by default.
package-lock.json text eol=lf linguist-generated=true

# Binary assets: never normalised, never diffed as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pdf   binary
*.mp4   binary
*.webm  binary
