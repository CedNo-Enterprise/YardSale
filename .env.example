# Copy to .env.local and fill in.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# GarageSaleAPI. Server-side only: the browser never talks to the API directly,
# so the bearer token stays in an httpOnly cookie.
API_URL=http://localhost:8080

# Sales are shown in the zone they happen in, not the reader's.
NEXT_PUBLIC_TIME_ZONE=America/Toronto

# Currency for sale item prices.
NEXT_PUBLIC_CURRENCY=CAD
